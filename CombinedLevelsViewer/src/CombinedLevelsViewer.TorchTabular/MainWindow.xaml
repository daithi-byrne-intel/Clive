<Window x:Class="CombinedLevelsViewer.TorchTabular.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Combined Levels Viewer (Torch tabular grid)"
        Height="800" Width="1400">
  <DockPanel>
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="Save" Click="OnSaveClick" ToolTip="Write both files to disk" Padding="8,2" />
        <Button Content="Reload from disk" Click="OnReloadClick" ToolTip="Discard unsaved edits and re-read both files" Padding="8,2" />
      </ToolBar>
    </ToolBarTray>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" />
      </StatusBarItem>
    </StatusBar>
    <Grid Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="120" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="340" MinWidth="120" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Level sets" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6" ToolTip="Filter level sets and test conditions" TextChanged="OnFilterChanged" />
        <TreeView x:Name="LevelTree" SelectedItemChanged="OnLevelSelectionChanged" />
      </DockPanel>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="2">
        <TextBlock x:Name="LevelTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
        <wv2:WebView2 x:Name="GridView" />
      </DockPanel>

      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="Test-condition context" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ListView x:Name="ContextList">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Item" Width="200" DisplayMemberBinding="{Binding Label}" />
              <GridViewColumn Header="Value" Width="120" DisplayMemberBinding="{Binding Value}" />
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
